/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@pf-app": ["./src/app/*"],
      "@pf-app/models": ["./src/app/models"],
      "@pf-app/components": ["./src/app/components"],
      "@pf-app/services": ["./src/app/services"],
      "@pf-app/types": ["./src/app/types"],
      "@pf-app/utils": ["./src/app/utils"],
      "@pf-app/pipes": ["./src/app/pipes"],
      "@pf-app/store": ["./src/app/state"],
      "environments/*": ["./src/environments/*"]
    },
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
